### Synth (structured inputs)
POST http://127.0.0.1:8787/fusion/synth
content-type: application/json
x-auth-key: {{AUTH_KEY}}

{
  "cdp": {
    "summary": "A single person with short dark hair wearing a denim jacket.",
    "observed_facts": ["one person", "denim jacket", "indoor scene"],
    "uncertainty_flags": ["eye color unclear"],
    "excluded_assumptions": ["identity not confirmed"],
    "confidence": 0.74
  },
  "acp": {
    "summary": "Warm indoor lighting with shallow background blur.",
    "observed_facts": ["warm light", "indoor", "blurred background"],
    "uncertainty_flags": ["time of day not visible"],
    "excluded_assumptions": ["location city unknown"],
    "confidence": 0.71
  },
  "sip": {
    "summary": "Naturalistic portrait style with medium close-up framing.",
    "observed_facts": ["portrait framing", "natural colors", "medium close-up"],
    "uncertainty_flags": ["lens focal length uncertain"],
    "excluded_assumptions": ["camera brand unknown"],
    "confidence": 0.69
  }
}

