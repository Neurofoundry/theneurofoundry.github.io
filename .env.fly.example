# Fly.io production env template
# Use: fly secrets set KEY=value

NODE_ENV=production
PORT=3000
APP_URL=https://<your-fly-api-domain>
FRONTEND_URL=https://<your-frontend-domain-or-fly-domain>

JWT_SECRET=<generate-strong-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<generate-strong-secret>
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=<generate-strong-secret>
SESSION_MAX_AGE=604800000

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=https://<your-frontend-domain>,https://www.<your-frontend-domain>

# Google OAuth (required for real Skeleton Key account login)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=https://<your-fly-api-domain>/api/auth/google/callback

# Email SMTP (required for real inbox delivery)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=no-reply@<your-domain>
CONTACT_FORM_TO=info@theneurofoundry.com
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# Cloudflare D1 (production account database)
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_D1_DATABASE_ID=<cloudflare-d1-database-id>
CLOUDFLARE_API_TOKEN=<cloudflare-api-token-with-d1-access>

# Cloudflare Images (profile avatars)
# Token needs account-level Cloudflare Images Edit permission.
CLOUDFLARE_IMAGES_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_IMAGES_API_TOKEN=<cloudflare-api-token-with-images-edit-access>
CLOUDFLARE_IMAGES_AVATAR_VARIANT=public
CLOUDFLARE_IMAGES_REQUIRE_SIGNED_URLS=false

# Cloudflare R2 profile avatar storage
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET=profile-avatar
R2_FORGE_BUCKET=forge-renders
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_PUBLIC_BASE_URL=

# Skeleton Key desktop code signing secret
SKELETON_KEY_CODE_SECRET=<generate-strong-secret>

# Square Checkout
# Use sandbox values for validation, then replace with production values for cutover.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=<square-application-id>
SQUARE_ACCESS_TOKEN=<square-access-token>
SQUARE_LOCATION_ID=<square-location-id>
SQUARE_API_VERSION=2026-01-22
SQUARE_CURRENCY=USD
SQUARE_SKELETON_KEY_NAME=Skeleton Key
SQUARE_SKELETON_KEY_PRICE_CENTS=300
PUBLIC_SITE_URL=https://www.theneurofoundry.com
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.theneurofoundry.com/api/payments/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=<square-webhook-signature-key>
